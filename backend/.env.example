# EasyInvoiceMgr 后端环境变量示例
# 用法：复制为 backend/.env 后按需修改（.env 已被 .gitignore 忽略，不要提交真实密钥）

# 数据库：项目已迁移到 SQLite，默认落在 backend/data/easy_invoice_mgr.sqlite，
# 不设置 DATABASE_URL 就用该默认值。
# 只有需要更换库文件位置时才取消注释，且必须是 sqlite:/// + 绝对路径；
# 填其他方言（例如 postgresql://...）会导致启动直接失败。
# DATABASE_URL=sqlite:///E:/AAACodeProjectMy/EasyInvoiceMgr/backend/data/easy_invoice_mgr.sqlite

# JWT / Flask 签名密钥（生产环境务必替换为随机值）
SECRET_KEY=easy-invoice-mgr-secret-key-2026
JWT_SECRET_KEY=easy-invoice-mgr-jwt-secret-key-2026-32bytes

# 智谱AI GLM 视觉模型（也可在系统设置里配置，DB 配置优先）
GLM_API_KEY=
GLM_MODEL=glm-4v-flash
